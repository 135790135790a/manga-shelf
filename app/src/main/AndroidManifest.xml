<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 导入期间的前台服务：切后台、锁屏不被系统回收。不是存储权限，只是保活。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 用于显示导入进度通知；用户拒绝也不影响导入本身 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 9 及以下把书页写进相册需要它；10+ 走 MediaStore，不需要任何权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
        按相簿浏览相册时读 MediaStore（v1.6.2）。
        Android 13+ 用 READ_MEDIA_IMAGES；12 及以下用 READ_EXTERNAL_STORAGE。
        运行时按需申请，不在冷启动时申请；用户拒绝时回退到系统 Photo Picker（零权限）。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MangaShelfApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MangaShelf">

        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:label="崩溃报告"
            android:theme="@style/Theme.MangaShelf" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.MangaShelf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ImportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- v1.6.3：图片工作栏的导入保活，独立于漫画侧服务 -->
        <service
            android:name=".service.GalleryImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
