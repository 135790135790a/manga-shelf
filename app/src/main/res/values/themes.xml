<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动窗口主题：决定 App 冷启动那一瞬间（Compose 还没画第一帧）的画面。

      三个主题：MainActivity 在 super.onCreate 之前按已保存的主题 setTheme 到 Day / Night，
      启动图（底色 + 居中的 App 图标）就和进来之后的界面一致，不会先闪一下黑。
      默认 Theme.MangaShelf 保持深色，给没有 setTheme 的公共路径兜底。

      启动图（v1.5.9 起）是「鲸鱼娘书架」：drawable-mdpi~xxhdpi/splash_whale(.jpg) 与
      splash_whale_night.jpg，按屏幕密度自动选一张，360dp 宽等比缩放居中，底色与
      DayBackground(#F6F4EF) / NightBackground(#16161B) 完全一致，所以冷启动窗口切到
      Compose 首帧时不会有色差跳变。
      不引 androidx.core:core-splashscreen，避免给启动路径再增加一个依赖和初始化开销。
    -->
    <style name="Theme.MangaShelf" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_screen_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 白天：暖白底 + 深色状态栏图标 -->
    <style name="Theme.MangaShelf.Day" parent="Theme.MangaShelf">
        <item name="android:windowBackground">@drawable/launch_screen_day</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 夜晚：深灰底（#16161B，和 NightBackground 同色，不是纯黑） -->
    <style name="Theme.MangaShelf.Night" parent="Theme.MangaShelf">
        <item name="android:windowBackground">@drawable/launch_screen_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>